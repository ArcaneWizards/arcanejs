{
  "name": "@arcanejs/examples-react",
  "version": "0.1.8",
  "private": true,
  "description": "Example app using toolkit",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsc --noEmit",
    "start": "node --import=tsx",
    "start:button-adder": "NODE_ENV=production pnpm start src/button-adder",
    "start:color-picker": "NODE_ENV=production pnpm start src/color-picker",
    "start:connections": "NODE_ENV=production pnpm start src/connections",
    "start:controlled-vs-uncontrolled": "NODE_ENV=production pnpm start src/controlled-vs-uncontrolled",
    "start:counter": "NODE_ENV=production pnpm start src/counter",
    "start:data-file": "NODE_ENV=production pnpm start src/data-file",
    "start:data-files": "NODE_ENV=production pnpm start src/data-files",
    "start:dynamic-connections": "NODE_ENV=production pnpm start src/dynamic-connections",
    "start:editable-group-title": "NODE_ENV=production pnpm start src/editable-group-title",
    "start:readme": "NODE_ENV=production pnpm start src/readme",
    "start:reorder-elements": "NODE_ENV=production pnpm start src/reorder-elements",
    "start:tabs-colors-inputs": "NODE_ENV=production pnpm start src/tabs-colors-inputs"
  },
  "devDependencies": {
    "@arcanejs/eslint-config": "workspace:^",
    "@types/eslint": "^8.56.5",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.14",
    "eslint": "^8.57.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@arcanejs/react-toolkit": "workspace:^",
    "@arcanejs/toolkit": "workspace:^",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "react": "^19.2.4",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  }
}
