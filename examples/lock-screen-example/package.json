{
  "name": "@arcanejs/examples-lock-screen-example",
  "version": "0.0.10",
  "private": true,
  "description": "Example app demonstrating a connection-scoped lock screen component",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsc --noEmit && pnpm build:frontend",
    "build:frontend": "rm -rf dist && pnpm build:styles && arcane-build-frontend --entry src/frontend.tsx --outfile dist/lock-screen-entrypoint.js --sourcemap",
    "build:styles": "tailwindcss -i ./src/frontend.css -o ./dist/lock-screen-entrypoint.css",
    "dev": "pnpm watch:frontend & pnpm watch:styles & tsx watch src",
    "start": "pnpm build:frontend && NODE_ENV=production node --import=tsx src",
    "watch:frontend": "arcane-build-frontend --watch --dev --entry src/frontend.tsx --outfile dist/lock-screen-entrypoint.js --sourcemap",
    "watch:styles": "tailwindcss --watch -i ./src/frontend.css -o ./dist/lock-screen-entrypoint.css"
  },
  "devDependencies": {
    "@arcanejs/build-utils": "workspace:^",
    "@arcanejs/eslint-config": "workspace:^",
    "@arcanejs/typescript-config": "workspace:^",
    "@tailwindcss/cli": "^4.1.18",
    "@types/eslint": "^8.56.5",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.14",
    "eslint": "^8.57.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@arcanejs/protocol": "workspace:^",
    "@arcanejs/react-toolkit": "workspace:^",
    "@arcanejs/toolkit": "workspace:^",
    "@arcanejs/toolkit-frontend": "workspace:^",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "react": "^19.2.4",
    "tsx": "^4.19.1"
  }
}
